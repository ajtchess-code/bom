{
  "name": "@bom/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js"},
    "./game-wiki": {"types": "./dist/gameWikiKnowledge.d.ts", "import": "./dist/gameWikiKnowledge.js", "default": "./dist/gameWikiKnowledge.js"},
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
