# =============================================================
# BOM-Bot - Novonode / production environment
# Single-guild architecture
# =============================================================

# ------------------------- Runtime -----------------------------
NODE_ENV=production
# Novonode may provide PORT automatically. DASHBOARD_PORT wins if set.
DASHBOARD_PORT=3000
API_PORT=4100
API_HOST=127.0.0.1
# Leave this at localhost when the supervisor runs API + dashboard together.
# Change only if the dashboard is intentionally deployed in a separate allocation.
INTERNAL_API_URL=http://127.0.0.1:4100

# Public hostname exposed through Cloudflare Tunnel.
PUBLIC_DASHBOARD_URL=https://dashboard.bandofmisfits.org

# Generate two DIFFERENT long random secrets (64+ chars recommended).
SESSION_SECRET=replace-with-64-plus-random-characters
INTERNAL_API_TOKEN=replace-with-another-long-random-value

# ----------------------- PostgreSQL ----------------------------
# PostgreSQL is the persistent source of truth. DATABASE_URL is preferred;
# POSTGRES_* values are used when DATABASE_URL is blank.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=bom_bot
POSTGRES_USER=bom_user
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_SIZE=12
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=10000
# Enable when your managed PostgreSQL service requires TLS.
POSTGRES_SSL=false
# Set false only for providers that use a private/self-signed certificate.
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# --------------------------- Redis -----------------------------
# Novonode: leave REDIS_URL blank and keep LOCAL_REDIS_ENABLED=true.
# BOM-Bot will download the official Redis package matching the host's Alpine
# release into /home/container/vendor/redis, bind it to 127.0.0.1 only, create
# /home/container/config/redis-password.txt, health-check it, and inject the
# private REDIS_URL into controller/API/worker processes automatically.
#
# To use an external Redis instead, set REDIS_URL and local bootstrap is skipped.
# To use BOM-Bot's PostgreSQL live-state fallback, set LOCAL_REDIS_ENABLED=false.
REDIS_URL=
LOCAL_REDIS_ENABLED=true
LOCAL_REDIS_PORT=6379
LOCAL_REDIS_MAXMEMORY_MB=256
# Optional path overrides; normally leave blank.
LOCAL_REDIS_VENDOR_DIR=
LOCAL_REDIS_CONFIG_DIR=
LOCAL_REDIS_DATA_DIR=
LOCAL_REDIS_PASSWORD_FILE=
LOCAL_REDIS_CONFIG_FILE=

# ------------------------- Discord -----------------------------
# ONE guild only. The controller and every worker will leave/ignore other guilds.
DISCORD_GUILD_ID=
DASHBOARD_ADMIN_ROLE_ID=

# Main controller application. This application is also used for dashboard OAuth.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Optional fallback for automated release posts. /feedback-admin setup stores the preferred channel in PostgreSQL.
CHANGELOG_CHANNEL_ID=

# Dedicated voice workers. Set WORKER_COUNT from 1-8 and fill only those tokens.
WORKER_COUNT=8
WORKER_1_TOKEN=
WORKER_2_TOKEN=
WORKER_3_TOKEN=
WORKER_4_TOKEN=
WORKER_5_TOKEN=
WORKER_6_TOKEN=
WORKER_7_TOKEN=
WORKER_8_TOKEN=

# ---------------------- Discord audio quality ------------------
# Tier 3 Discord servers currently support up to 384 kbps voice-channel bitrate.
# The controller will try to keep configured music voice channels at this target
# when it has Manage Channels. It automatically clamps to the guild's actual cap.
VOICE_BITRATE_TARGET=384000
ENFORCE_VOICE_CHANNEL_BITRATE=true

# Private Components V2 panels delete after this many seconds without interaction.
# Any valid interaction with that exact panel renews the timer.
EPHEMERAL_IDLE_SECONDS=90

# ------------------------- Lavalink ----------------------------
# Lavalink v4 endpoint. URL is host:port, without http:// unless your provider
# explicitly tells you otherwise. LAVALINK_SECURE=true uses TLS/WSS.
LAVALINK_URL=127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_SEARCH_PREFIX=ytmsearch:

# Dashboard health indicators; align these with the plugins on your hosted node.
LAVASRC_ENABLED=true
LAVALYRICS_ENABLED=true

# ------------------- Metadata / recommendations ----------------
# Optional. Enables richer metadata and similarity-based recommendations.
LASTFM_API_KEY=
# MusicBrainz asks clients to identify themselves with a contact address.
MUSICBRAINZ_CONTACT=admin@example.com

# ---------------------- Cloudflare Tunnel ----------------------
# If Novonode permits running cloudflared inside this allocation, set both.
# Otherwise run the connector elsewhere and route it to the dashboard origin.
CLOUDFLARE_TUNNEL_TOKEN=
# Novonode defaults; normally you can leave these as-is when the files are in root.
CLOUDFLARED_PATH=/home/container/cloudflared
CLOUDFLARE_TUNNEL_TOKEN_FILE=/home/container/cloudflare-token.txt
TUNNEL_TRANSPORT_PROTOCOL=auto

# -------------------------- Build ------------------------------
# Every start rebuilds once from the uploaded source. Set to 1 only to restart
# quickly with the existing build when nothing changed.
SKIP_STARTUP_BUILD=0
# Days an unused rendered port-battle image stays in data/pb-art (minimum 7).
PB_ART_RETENTION_DAYS=45

# Optional music-worker branding storage overrides.
# Defaults are bundled under apps/dashboard/public/branding/defaults.
# Custom uploads are persisted under /home/container/data/branding.
BRANDING_DATA_DIR=/home/container/data/branding
# BRANDING_DEFAULT_DIR=/home/container/apps/dashboard/public/branding/defaults

# Music platform resilience / performance
# Comma-separated backup Lavalink nodes, used automatically if primary is unavailable.
LAVALINK_SECONDARY_URLS=
# Cold Discord voice join stabilization delay. 75-150ms is usually enough.
VOICE_JOIN_SETTLE_MS=100
# Discord authorization/context cache TTLs for fast dashboard actions.
DISCORD_ACCESS_CACHE_MS=90000
DISCORD_MEMBER_CACHE_MS=90000
DISCORD_GUILD_ROLE_CACHE_MS=300000
DISCORD_CONTEXT_CACHE_MS=30000

# Decorative music visualizer
# No audio analysis is performed. Discord uses bundled worker-colored looping GIFs,
# while the dashboard uses a lightweight CSS animation.
MUSIC_VISUALIZER_ENABLED=true

# ---------------- Smart resolver / source fallback ----------------
# Search providers are attempted in parallel and ranked by title/artist/source.
LAVALINK_SEARCH_CHAIN=ytmsearch:,ytsearch:,scsearch:
RESOLVER_MAX_CANDIDATES=10
RESOLVER_REJECT_VARIANTS=true
RESOLVER_FALLBACK_ON_FAILURE=true
# Optional preferred Lavalink sourceName, e.g. youtube or soundcloud.
RESOLVER_PREFERRED_SOURCE=

# ---------------------- Voice ducking ----------------------------
# Playback workers can consume voice-activity events from a compatible producer.
# No inbound Discord voice audio is recorded by BOM itself.
VOICE_ACTIVITY_PROVIDER=NONE
VOICE_ACTIVITY_REDIS_CHANNEL=music:voice-activity

# ---------------- Server automation / social feeds ----------------
# Stable encryption key for API credentials saved from the Admin dashboard.
# Generate a long random value and KEEP IT STABLE across restarts/upgrades.
SOCIAL_CREDENTIALS_KEY=
PUBLIC_DASHBOARD_URL=https://dashboard.bandofmisfits.org

# YouTube Data API v3. Used for account resolution, archive importing and
# polling recovery. New uploads can additionally use WebSub push delivery.
YOUTUBE_API_KEY=

# Twitch Helix/EventSub application credentials.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Reddit authenticated public listing API credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BOMSocial/1.0

# X API bearer token. Available capabilities depend on the X developer tier.
X_BEARER_TOKEN=

# Official Meta Graph API credentials. Instagram monitoring is limited to
# accounts available through authorized professional/business Graph access.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# -------------------- Diagnostics / logging ---------------------
# Console log verbosity: debug, info, warn, error.
BOM_LOG_LEVEL=info
# pretty = readable Novonode console lines, json = machine-readable one-line records.
BOM_LOG_FORMAT=pretty
# Evaluate process health every N seconds. Healthy snapshots are DEBUG-only; breached thresholds emit WARN. 0 disables.
BOM_DIAGNOSTIC_HEARTBEAT_SEC=300
# Health warning thresholds. Tune only if your host has unusual resource limits.
BOM_HEALTH_RSS_WARN_MB=512
BOM_HEALTH_HEAP_WARN_MB=384
BOM_HEALTH_EVENT_LOOP_P95_WARN_MS=100
BOM_HEALTH_EVENT_LOOP_MAX_WARN_MS=500
BOM_HEALTH_ACTIVE_REQUESTS_WARN=50
# Log PostgreSQL statements that exceed this duration. Values/parameters are never printed.
DB_SLOW_QUERY_MS=250
# Successful API requests faster than this are DEBUG-only. Slow requests remain visible at WARN.
API_SLOW_REQUEST_MS=750

# BOM Sentinel — unified Discord/BOM logging, backups, and recovery
SENTINEL_MESSAGE_ARCHIVE_ENABLED=true
SENTINEL_MEDIA_ARCHIVE_ENABLED=true
SENTINEL_ASSET_MAX_BYTES=8388608
SENTINEL_SNAPSHOT_INTERVAL_MINUTES=360
SENTINEL_AUDIT_POLL_MS=5000
SENTINEL_VERBOSE_ACTIVITY=false
SENTINEL_PRESENCE_LOGGING=false
# Optional. If omitted, Sentinel derives an encryption key from SESSION_SECRET.
# SENTINEL_ENCRYPTION_KEY=
SENTINEL_MESSAGE_BACKFILL_ENABLED=true

# Optional comma-separated Discord role IDs allowed to use /ask in addition to DASHBOARD_ADMIN_ROLE_ID.
SENTINEL_ASK_ROLE_IDS=

# ---------------- Optional OpenAI intelligence ----------------
# Leave OPENAI_API_KEY empty to keep both features fully deterministic/offline.
# The key should be stored in Novonode Startup/Variables, not committed to source.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Sentinel uses AI only to interpret/translate natural-language intent and bind the
# question to candidate Discord users/channels/roles. Korean, Russian, and Spanish
# full-sentence translation uses this flag. Answers still come only from Sentinel's
# recorded audit/event evidence; the model cannot create the factual answer.
OPENAI_SENTINEL_ENABLED=false
OPENAI_SENTINEL_MODEL=gpt-6-luna

# Music Trivia can use Responses API web search for a cited, interesting fact, then
# caches the result. If disabled/unavailable it falls back to local metadata trivia.
OPENAI_MUSIC_TRIVIA_ENABLED=false
OPENAI_MUSIC_TRIVIA_MODEL=gpt-6-luna
OPENAI_MUSIC_TRIVIA_WEB_SEARCH=true

# ---------------- BOM Wiki / Knowledge Engine -----------------
# Optional: OpenAI is used only to interpret/translate natural-language questions/corrections.
# Korean, Russian, and Spanish full-sentence translation uses this flag; a deterministic
# keyword fallback remains when disabled. Factual answers still come exclusively from
# BOM Wiki records, deterministic calculations, and administrator corrections.
OPENAI_WIKI_ENABLED=false
OPENAI_WIKI_MODEL=gpt-6-luna
