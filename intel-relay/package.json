{
  "name": "discord-message-relay-ts",
  "version": "3.1.0",
  "private": true,
  "description": "Multi-account user-session Discord relay with private setup dashboard",
  "type": "module",
  "engines": {
    "node": "^22.21.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "discord.js-selfbot-v13": "3.7.1",
    "dotenv": "^17.2.3",
    "sharp": "^0.34.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
