# Copy to intel-relay/.env. Keep this separate from the root bot .env.
DASHBOARD_PASSWORD=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8196
PUBLIC_ORIGIN=https://intel.bandofmisfits.org
COOKIE_SECURE=true
DATA_DIR=./data
LOG_LEVEL=info
